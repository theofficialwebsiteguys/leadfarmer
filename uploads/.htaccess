# ============================================================================
# Uploaded images — served as static files, never executed.
#
# Defence in depth: Uploads.php already validates the real MIME type and
# generates the filename/extension, so a script should never land here. If one
# somehow did, these rules stop Apache from running it.
# ============================================================================

# Turn off every scripting handler for this directory and below.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .jsp .asp .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py

Options -ExecCGI -Indexes

# Belt and braces: refuse to serve anything that is not an allowed image type.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|cgi|pl|py|jsp|asp|aspx|sh|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Stop a browser from re-interpreting an image as something executable.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Disposition "inline"
    # Uploaded images are content-addressed by a random filename, so they can be
    # cached hard; replacing an image produces a new filename.
    Header always set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
